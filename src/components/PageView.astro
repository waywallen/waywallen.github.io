---
import BaseLayout from '../layouts/BaseLayout.astro';
import { content } from '../i18n/content';
import { route, type Locale, type RouteSlug } from '../i18n/config';
interface Props {
  locale: Locale;
  slug: RouteSlug;
}
const { locale, slug } = Astro.props;
const copy = content[locale];
const page = copy.pages[slug];
const screenshots = [
  '/images/screenshots/main-page.webp',
  '/images/screenshots/displays-page.webp',
  '/images/screenshots/status-page.webp',
];
const sizes = [
  [885, 643],
  [1771, 1280],
  [1770, 1279],
];
const integrations = [
  ['KDE Plasma', 'waywallen-display', true, true],
  ['GNOME', 'waywallen-display', true, true],
  ['Hyprland', 'layer_shell', true, true],
  ['Niri', 'layer_shell', true, true],
  ['Wayfire', 'layer_shell', true, true],
  ['Sway', 'layer_shell', true, false],
  ['COSMIC', 'layer_shell', true, false],
] as const;
const external = {
  AppImage: 'https://github.com/waywallen/waywallen/releases/latest',
  Flatpak: 'https://flathub.org/apps/org.waywallen.waywallen',
  source: 'https://github.com/waywallen/waywallen/blob/main/BUILD.md',
};
const isDocsArticle = slug.startsWith('docs/');
const docKey =
  slug === 'docs/installation'
    ? 'installation'
    : slug === 'docs/desktop-integration'
      ? 'desktop'
      : slug === 'docs/wallpaper-engine'
        ? 'wallpaper'
        : 'troubleshooting';
---

<BaseLayout locale={locale} slug={slug}>
  {
    slug === '' ? (
      <>
        <section class="hero section">
          <>
            <div class="hero-copy">
              <>
                <p class="eyebrow">{copy.hero.eyebrow}</p>
                <h1>{copy.hero.title}</h1>
                <p class="hero-body">{copy.hero.body}</p>
                <div class="button-row">
                  <>
                    <a class="button primary" href={route(locale, 'download')}>
                      {copy.hero.download}
                    </a>
                    <a
                      class="button tonal"
                      href="https://github.com/waywallen/waywallen"
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      {copy.hero.github}
                    </a>
                  </>
                </div>
              </>
            </div>
            <div class="hero-visual">
              <>
                <div class="window-chrome">
                  <>
                    <span />
                    <span />
                    <span />
                    <strong>waywallen</strong>
                  </>
                </div>
                <img
                  src={screenshots[0]}
                  width="885"
                  height="643"
                  alt={copy.screenshotText[0][0]}
                  fetchpriority="high"
                />
              </>
            </div>
          </>
        </section>
        <section class="section">
          <>
            <div class="section-heading">
              <>
                <div>
                  <>
                    <p class="eyebrow">{copy.nav.features}</p>
                    <h2>{copy.sections.highlights}</h2>
                  </>
                </div>
                <p>{copy.sections.highlightsBody}</p>
              </>
            </div>
            <div class="feature-grid">
              {copy.featureText.slice(0, 4).map(([title, body], i) => (
                <article class:list={['feature-card', i === 0 && 'featured']}>
                  <span class="feature-number">0{i + 1}</span>
                  <h3>{title}</h3>
                  <p>{body}</p>
                </article>
              ))}
            </div>
          </>
        </section>
        <section class="section desktop-band">
          <>
            <div>
              <>
                <p class="eyebrow">Linux</p>
                <h2>{copy.sections.desktops}</h2>
                <p>{copy.sections.desktopsBody}</p>
              </>
            </div>
            <div class="chip-cloud">
              {integrations.map(([name]) => (
                <span class="chip">{name}</span>
              ))}
            </div>
          </>
        </section>
        <section class="section">
          <>
            <div class="section-heading">
              <>
                <div>
                  <>
                    <p class="eyebrow">{copy.nav.screenshots}</p>
                    <h2>{copy.sections.gallery}</h2>
                  </>
                </div>
                <p>{copy.sections.galleryBody}</p>
              </>
            </div>
            <a class="screenshot-teaser" href={route(locale, 'screenshots')}>
              <img
                src={screenshots[1]}
                width="1771"
                height="1280"
                alt={copy.screenshotText[1][0]}
                loading="lazy"
              />
            </a>
          </>
        </section>
      </>
    ) : (
      <>
        <header class="page-hero section">
          <>
            <p class="eyebrow">Waywallen</p>
            <h1>{page.title}</h1>
            <p>{page.description}</p>
          </>
        </header>
        {slug === 'features' && (
          <section class="section feature-grid all-features">
            {copy.featureText.map(([title, body], i) => (
              <article class="feature-card">
                <span class="feature-number">0{i + 1}</span>
                <h2>{title}</h2>
                <p>{body}</p>
              </article>
            ))}
          </section>
        )}
        {slug === 'screenshots' && (
          <section class="section gallery-grid">
            {copy.screenshotText.map(([title, body], i) => (
              <figure class="screenshot-card">
                <img
                  src={screenshots[i]}
                  width={sizes[i][0]}
                  height={sizes[i][1]}
                  alt={title}
                  loading={i === 0 ? 'eager' : 'lazy'}
                />
                <figcaption>
                  <h2>{title}</h2>
                  <p>{body}</p>
                </figcaption>
              </figure>
            ))}
          </section>
        )}
        {slug === 'download' && (
          <section class="section card-grid">
            {copy.downloadText.map(([title, body, action], i) => (
              <article class="action-card">
                <h2>{title}</h2>
                <p>{body}</p>
                <a
                  class="button tonal"
                  href={
                    i === 0
                      ? external.AppImage
                      : i === 1
                        ? external.Flatpak
                        : external.source
                  }
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {action}
                </a>
              </article>
            ))}
          </section>
        )}
        {slug === 'plugins' && (
          <section class="section card-grid">
            {copy.pluginText.map(([title, body], i) => (
              <article class="action-card">
                <span class="status-chip">
                  {i === 3 ? 'Third-party' : 'Official'}
                </span>
                <h2>{title}</h2>
                <p>{body}</p>
                {i === 3 && (
                  <a
                    class="text-link"
                    href="https://github.com/waywallen/open-wallpaper-engine"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    GitHub →
                  </a>
                )}
              </article>
            ))}
          </section>
        )}
        {slug === 'docs' && (
          <section class="section docs-grid">
            {copy.docsCards.map(([title, body, path]) => (
              <a class="docs-card" href={route(locale, path)}>
                <h2>{title}</h2>
                <p>{body}</p>
                <span aria-hidden="true">→</span>
              </a>
            ))}
          </section>
        )}
        {isDocsArticle && (
          <section class="section docs-layout">
            <aside>
              <nav aria-label={copy.nav.docs}>
                {copy.docsCards.map(([title, , path]) => (
                  <a
                    class:list={{ active: path === slug }}
                    href={route(locale, path)}
                  >
                    {title}
                  </a>
                ))}
              </nav>
            </aside>
            <article class="prose">
              <h2>{page.title}</h2>
              <ol>
                {copy.doc[docKey].map((item) => (
                  <li>{item}</li>
                ))}
              </ol>
              {slug === 'docs/desktop-integration' && (
                <a
                  class="button tonal"
                  href="https://github.com/waywallen/waywallen-display"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  waywallen-display
                </a>
              )}
              {slug === 'docs/wallpaper-engine' && (
                <a
                  class="button tonal"
                  href="https://github.com/waywallen/open-wallpaper-engine/releases/latest"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  open-wallpaper-engine
                </a>
              )}
              {slug === 'docs/troubleshooting' && (
                <pre>
                  <code>
                    flatpak override --user
                    --talk-name='org.mpris.MediaPlayer2.*'
                    org.waywallen.waywallen
                  </code>
                </pre>
              )}
            </article>
          </section>
        )}
        {slug === 'faq' && (
          <section class="section faq-list">
            {copy.faq.map(([question, answer]) => (
              <details>
                <summary>{question}</summary>
                <p>{answer}</p>
              </details>
            ))}
          </section>
        )}
        {(slug === 'features' || slug === 'docs/desktop-integration') && (
          <section class="section compatibility">
            <div class="section-heading">
              <div>
                <p class="eyebrow">Linux</p>
                <h2>{copy.sections.desktops}</h2>
              </div>
              <p>{copy.sections.desktopsBody}</p>
            </div>
            <div class="table-wrap">
              <table>
                <thead>
                  <tr>
                    <th>{copy.integration.desktop}</th>
                    <th>{copy.integration.integration}</th>
                    <th>{copy.integration.mouse}</th>
                    <th>{copy.integration.pause}</th>
                  </tr>
                </thead>
                <tbody>
                  {integrations.map(([desktop, integration, mouse, pause]) => (
                    <tr>
                      <th>{desktop}</th>
                      <td>{integration}</td>
                      <td>
                        <span class:list={['support', mouse ? 'yes' : 'no']}>
                          {mouse ? copy.integration.yes : copy.integration.no}
                        </span>
                      </td>
                      <td>
                        <span class:list={['support', pause ? 'yes' : 'no']}>
                          {pause ? copy.integration.yes : copy.integration.no}
                        </span>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </section>
        )}
      </>
    )
  }
</BaseLayout>
