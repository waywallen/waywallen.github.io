---
import BaseLayout from '../layouts/BaseLayout.astro';
import { content } from '../i18n/content';
import { route, type Locale } from '../i18n/config';

const { locale, detectLocale = false } = Astro.props as {
  locale: Locale;
  detectLocale?: boolean;
};
const copy = content[locale];
---

<BaseLayout
  locale={locale}
  slug=""
  is404
  detect404Locale={detectLocale}
  titleOverride={copy.notFound.title}
  descriptionOverride={copy.notFound.body}
>
  <section class="not-found section">
    <p class="error-code">404</p>
    <h1>{copy.notFound.title}</h1>
    <p>{copy.notFound.body}</p>
    <a class="button primary" href={route(locale)}>{copy.notFound.action}</a>
  </section>
</BaseLayout>
