---
import PageView from '../../components/PageView.astro';
import type { Locale } from '../../i18n/config';
export function getStaticPaths() {
  return ['ru', 'zh-cn'].map((locale) => ({
    params: { locale },
    props: { locale },
  }));
}
const { locale } = Astro.props as { locale: Locale };
---

<PageView locale={locale} slug="" />
